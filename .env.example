# Copy this file to .env.local and fill in the real values. .env.local is gitignored.
# See docs/specs/github-workflow-deployment-specification.md Section 4 for details.

# --- Supabase ---
# Project URL and anon/public key from the Supabase project's API settings.
# Both are exposed to the client by design; the anon key is protected by Row-Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Resend ---
# API key for the contact-form email notification. Server-only — never exposed to the client.
RESEND_API_KEY=

# Address contact-form notifications are sent to. Must match the email
# registered on the Resend account itself — Resend's sandbox mode (no
# verified custom domain) only delivers to that one address
# (backend-specification.md §6.4). Server-only.
CONTACT_TO_EMAIL=

# --- Search engine verification (seo-specification.md §11) ---
# The one-line HTML meta tag value each service gives you after creating a
# URL-prefix property for https://bossstrong-dev.vercel.app. Optional — the
# verification meta tag is simply omitted until these are set. Exposed to the
# client by design (verification meta tags are public anyway).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Not configured here, on purpose ---
# Google OAuth client ID / secret: set in the Supabase Auth dashboard, not as app env vars.
# SUPABASE_DB_URL: GitHub Actions secret only (weekly backup workflow) — never add it to this file.
